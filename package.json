{
  "name": "plmsystem",
  "private": true,
  "version": "1.0.0",
  "description": "Plate Lifecycle Monitoring System",
  "main": "electron.js",
  "type": "module",

  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",

    "electron": "electron .",
    "electron-build": "vite build && electron-builder --win portable"
  },

  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },

  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },

  "build": {
    "appId": "com.plmsystem.app",
    "productName": "PLM System",

    "directories": {
      "output": "release"
    },

    "files": [
      "dist/**/*",
      "electron.js"
    ],

    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
